<%- include('../../partials/header') %>

<h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-6">Saved Recipes</h1>

<% if (typeof recipes !== 'undefined' && recipes.length > 0) { %>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-4">
    <% recipes.forEach(function(recipe) { %>
      <a href="/recipes/saved/<%= recipe.id %>" class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden flex flex-col hover:shadow-md transition-shadow">
        <% if (recipe.imageUrl) { %>
          <img src="<%= recipe.imageUrl %>" alt="<%= recipe.title %>" class="w-full h-48 object-cover">
        <% } %>
        <div class="p-5 flex-1 flex flex-col">
          <h4 class="font-semibold text-gray-900 dark:text-white mb-1"><%= recipe.title %></h4>
          <div class="flex items-center gap-2 mb-1">
            <span class="tag text-xs"><%= recipe.source || 'unknown' %></span>
            <% if (recipe.servings) { %>
              <span class="text-xs text-gray-500 dark:text-gray-400">&middot; <%= recipe.servings %> servings</span>
            <% } %>
          </div>
          <% if (recipe.createdAt) { %>
            <p class="text-xs text-gray-400 dark:text-gray-500 mb-1">Saved on <%= new Date(recipe.createdAt).toLocaleDateString() %></p>
          <% } %>

          <%
            var nutrition = recipe.nutritionJson;
            if (typeof nutrition === 'string') { try { nutrition = JSON.parse(nutrition); } catch(e) { nutrition = null; } }
            var srv = recipe.servings || 1;
          %>
          <% if (nutrition && nutrition.calories) { %>
            <div class="flex flex-wrap gap-3 text-xs text-gray-500 dark:text-gray-400 mb-3">
              <span><strong><%= Math.round(nutrition.calories / srv) %></strong> cal</span>
              <% if (nutrition.protein) { %><span><strong><%= Math.round(nutrition.protein / srv) %>g</strong> protein</span><% } %>
              <% if (nutrition.carbs) { %><span><strong><%= Math.round(nutrition.carbs / srv) %>g</strong> carbs</span><% } %>
              <% if (nutrition.fat) { %><span><strong><%= Math.round(nutrition.fat / srv) %>g</strong> fat</span><% } %>
            </div>
          <% } else { %>
            <div class="mb-3"></div>
          <% } %>

          <div class="mt-auto flex items-end gap-2" onclick="event.preventDefault(); event.stopPropagation();">
            <form method="POST" action="/recipes/saved/<%= recipe.id %>/cook" class="flex items-end gap-2 flex-1">
              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
              <div class="flex-1">
                <label class="text-xs text-gray-500 dark:text-gray-400">Servings</label>
                <input type="number" name="servings" min="1" value="<%= recipe.servings || 1 %>" class="form-input text-sm py-1" onclick="event.stopPropagation()">
              </div>
              <button type="submit" class="btn-primary text-sm py-1 px-3">Cook</button>
            </form>
            <button type="button" class="btn-ghost text-red-500 hover:text-red-700 dark:text-red-400 dark:hover:text-red-300 p-1.5" onclick="event.preventDefault(); event.stopPropagation(); openDeleteModal('<%= recipe.id %>', '<%= recipe.title.replace(/'/g, '\\&#39;') %>')" title="Delete recipe">
              <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
            </button>
          </div>
        </div>
      </a>
    <% }); %>
  </div>
<% } else { %>
  <div class="text-center py-12">
    <p class="text-gray-500 dark:text-gray-400 mb-4">No saved recipes yet.</p>
    <a href="/recipes" class="btn-secondary">Find Recipes</a>
  </div>
<% } %>

<dialog id="deleteModal" class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-xl p-6 max-w-sm backdrop:bg-black/50">
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Delete Recipe</h3>
  <p class="text-sm text-gray-600 dark:text-gray-400 mb-5">Are you sure you want to delete <strong id="deleteRecipeTitle"></strong>? This cannot be undone.</p>
  <form id="deleteForm" method="POST" action="">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="flex justify-end gap-3">
      <button type="button" class="btn-secondary text-sm" onclick="document.getElementById('deleteModal').close()">Cancel</button>
      <button type="submit" class="btn-primary text-sm bg-red-600 hover:bg-red-700 border-red-600 hover:border-red-700">Delete</button>
    </div>
  </form>
</dialog>

<script>
function openDeleteModal(id, title) {
  document.getElementById('deleteRecipeTitle').textContent = title;
  document.getElementById('deleteForm').action = '/recipes/saved/' + id + '/delete';
  document.getElementById('deleteModal').showModal();
}
</script>

<%- include('../../partials/footer') %>
