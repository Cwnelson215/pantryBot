<%- include('../../partials/header') %>

<div class="mb-4">
  <a href="/recipes/saved" class="text-sm text-primary dark:text-primary-light hover:underline">&larr; Back to Saved Recipes</a>
</div>

<h1 class="text-2xl font-bold text-gray-900 dark:text-white mb-4"><%= recipe.title %></h1>

<% if (recipe.imageUrl) { %>
  <img src="<%= recipe.imageUrl %>" alt="<%= recipe.title %>" class="w-full max-w-2xl h-64 object-cover rounded-xl mb-6">
<% } %>

<div class="flex flex-wrap gap-4 mb-6">
  <% if (recipe.source) { %>
    <span class="tag text-xs"><%= recipe.source %></span>
  <% } %>
  <% if (recipe.servings) { %>
    <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
      <span><strong>Servings:</strong> <%= recipe.servings %></span>
    </div>
  <% } %>
  <% if (recipe.readyInMinutes) { %>
    <div class="flex items-center gap-2 text-sm text-gray-600 dark:text-gray-400">
      <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
      <span><strong>Ready in:</strong> <%= recipe.readyInMinutes %> minutes</span>
    </div>
  <% } %>
</div>

<% if (recipe.personalization) { %>
  <div class="bg-blue-50 dark:bg-blue-900/20 border border-blue-200 dark:border-blue-800 rounded-xl p-4 mb-6">
    <div class="flex items-start gap-3">
      <svg class="w-5 h-5 text-blue-500 mt-0.5 flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 10V3L4 14h7v7l9-11h-7z"/></svg>
      <div>
        <h4 class="font-semibold text-blue-800 dark:text-blue-300 mb-1">Personalization Notes</h4>
        <p class="text-sm text-blue-700 dark:text-blue-400 whitespace-pre-line"><%= recipe.personalization %></p>
      </div>
    </div>
  </div>
<% } %>

<!-- Ingredients -->
<% if (ingredients && ingredients.length > 0) { %>
  <section class="mb-6">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Ingredients</h2>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-5">
      <ul class="space-y-1.5 text-sm text-gray-700 dark:text-gray-300">
        <% ingredients.forEach(function(ing) { %>
          <li class="flex items-start gap-2">
            <span class="text-primary dark:text-primary-light mt-1">&#8226;</span>
            <span><%= typeof ing === 'string' ? ing : (ing.original || ing.name || JSON.stringify(ing)) %></span>
          </li>
        <% }); %>
      </ul>
    </div>
  </section>
<% } %>

<!-- Instructions -->
<% if (instructions) { %>
  <section class="mb-6">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Instructions</h2>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm p-5">
      <% if (Array.isArray(instructions)) { %>
        <% if (instructions.length > 0 && instructions[0].steps) { %>
          <ol class="space-y-3 text-sm text-gray-700 dark:text-gray-300 list-decimal list-inside">
            <% instructions.forEach(function(group) { %>
              <% if (group.steps) { %>
                <% group.steps.forEach(function(step) { %>
                  <li class="leading-relaxed"><%= step.step %></li>
                <% }); %>
              <% } %>
            <% }); %>
          </ol>
        <% } else { %>
          <ol class="space-y-3 text-sm text-gray-700 dark:text-gray-300 list-decimal list-inside">
            <% instructions.forEach(function(step) { %>
              <li class="leading-relaxed"><%= typeof step === 'string' ? step : (step.step || JSON.stringify(step)) %></li>
            <% }); %>
          </ol>
        <% } %>
      <% } else { %>
        <div class="text-sm text-gray-700 dark:text-gray-300 leading-relaxed whitespace-pre-line"><%= instructions %></div>
      <% } %>
    </div>
  </section>
<% } %>

<!-- Nutrition Info (per serving) -->
<% if (typeof nutrition !== 'undefined' && nutrition) { %>
  <section class="mb-6">
    <h2 class="text-lg font-semibold text-gray-900 dark:text-white mb-3">Nutrition <span class="text-sm font-normal text-gray-500 dark:text-gray-400">(per serving)</span></h2>
    <div class="bg-white dark:bg-gray-800 rounded-xl border border-gray-200 dark:border-gray-700 shadow-sm overflow-hidden">
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-px bg-gray-200 dark:bg-gray-700">
        <% if (nutrition.calories) { %>
          <div class="bg-white dark:bg-gray-800 p-4 text-center">
            <p class="text-lg font-bold text-gray-900 dark:text-white"><%= nutrition.calories %></p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Calories</p>
          </div>
        <% } %>
        <% if (nutrition.protein) { %>
          <div class="bg-white dark:bg-gray-800 p-4 text-center">
            <p class="text-lg font-bold text-gray-900 dark:text-white"><%= nutrition.protein %>g</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Protein</p>
          </div>
        <% } %>
        <% if (nutrition.carbs) { %>
          <div class="bg-white dark:bg-gray-800 p-4 text-center">
            <p class="text-lg font-bold text-gray-900 dark:text-white"><%= nutrition.carbs %>g</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Carbs</p>
          </div>
        <% } %>
        <% if (nutrition.fat) { %>
          <div class="bg-white dark:bg-gray-800 p-4 text-center">
            <p class="text-lg font-bold text-gray-900 dark:text-white"><%= nutrition.fat %>g</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Fat</p>
          </div>
        <% } %>
        <% if (nutrition.fiber) { %>
          <div class="bg-white dark:bg-gray-800 p-4 text-center">
            <p class="text-lg font-bold text-gray-900 dark:text-white"><%= nutrition.fiber %>g</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Fiber</p>
          </div>
        <% } %>
        <% if (nutrition.sugar) { %>
          <div class="bg-white dark:bg-gray-800 p-4 text-center">
            <p class="text-lg font-bold text-gray-900 dark:text-white"><%= nutrition.sugar %>g</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Sugar</p>
          </div>
        <% } %>
        <% if (nutrition.sodium) { %>
          <div class="bg-white dark:bg-gray-800 p-4 text-center">
            <p class="text-lg font-bold text-gray-900 dark:text-white"><%= nutrition.sodium %>mg</p>
            <p class="text-xs text-gray-500 dark:text-gray-400">Sodium</p>
          </div>
        <% } %>
      </div>
    </div>
  </section>
<% } %>

<!-- Action Buttons -->
<section>
  <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3">
    <!-- Cook -->
    <form method="POST" action="/recipes/saved/<%= recipe.id %>/cook" class="flex items-end gap-2">
      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
      <div class="flex-1">
        <label class="text-xs text-gray-500 dark:text-gray-400">Servings</label>
        <input type="number" name="servings" min="1" value="<%= recipe.servings || 1 %>" class="form-input text-sm py-1">
      </div>
      <button type="submit" class="btn-primary text-sm py-1.5 px-4">Cook</button>
    </form>

    <% if (typeof nutrition !== 'undefined' && nutrition && nutrition.calories) { %>
      <!-- Log as Meal -->
      <form method="POST" action="/nutrition/log">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <input type="hidden" name="foodName" value="<%= recipe.title %>">
        <input type="hidden" name="calories" value="<%= nutrition.calories || 0 %>">
        <input type="hidden" name="protein" value="<%= nutrition.protein || 0 %>">
        <input type="hidden" name="carbs" value="<%= nutrition.carbs || 0 %>">
        <input type="hidden" name="fat" value="<%= nutrition.fat || 0 %>">
        <input type="hidden" name="fiber" value="<%= nutrition.fiber || 0 %>">
        <input type="hidden" name="sugar" value="<%= nutrition.sugar || 0 %>">
        <input type="hidden" name="sodium" value="<%= nutrition.sodium || 0 %>">
        <input type="hidden" name="servings" value="1">
        <button type="submit" class="btn-secondary w-full">
          <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5H7a2 2 0 00-2 2v12a2 2 0 002 2h10a2 2 0 002-2V7a2 2 0 00-2-2h-2M9 5a2 2 0 002 2h2a2 2 0 002-2M9 5a2 2 0 012-2h2a2 2 0 012 2"/></svg>
          Log as Meal
        </button>
      </form>
    <% } %>

    <!-- Delete -->
    <button type="button" onclick="document.getElementById('deleteModal').showModal()" class="btn-secondary w-full text-red-600 dark:text-red-400 border-red-300 dark:border-red-700 hover:bg-red-50 dark:hover:bg-red-900/20">
      <svg class="w-4 h-4 mr-1.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16"/></svg>
      Delete
    </button>
  </div>
</section>

<dialog id="deleteModal" class="rounded-xl border border-gray-200 dark:border-gray-700 bg-white dark:bg-gray-800 shadow-xl p-6 max-w-sm backdrop:bg-black/50">
  <h3 class="text-lg font-semibold text-gray-900 dark:text-white mb-2">Delete Recipe</h3>
  <p class="text-sm text-gray-600 dark:text-gray-400 mb-5">Are you sure you want to delete <strong><%= recipe.title %></strong>? This cannot be undone.</p>
  <form method="POST" action="/recipes/saved/<%= recipe.id %>/delete">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div class="flex justify-end gap-3">
      <button type="button" class="btn-secondary text-sm" onclick="document.getElementById('deleteModal').close()">Cancel</button>
      <button type="submit" class="btn-primary text-sm bg-red-600 hover:bg-red-700 border-red-600 hover:border-red-700">Delete</button>
    </div>
  </form>
</dialog>

<%- include('../../partials/footer') %>
